# Copy this file to backend/.env before starting Docker Compose.
# Every key below is consumed by the backend. Blank credential fields disable
# that integration rather than falling back to a shared/hardcoded value.
# Never commit real secrets.

# ── Core ─────────────────────────────────────────────────────────────
# Secret used to sign and verify JWTs. Read by app/routers/auth.py as
# JWT_SECRET — note the name is JWT_SECRET, NOT JWT_SECRET_KEY. The backend
# refuses to start without it. Use a long random value (>=32 chars).
JWT_SECRET=replace-with-a-long-random-secret
# Bootstrap admin password. ONLY used the first time the backend starts with an
# EMPTY users table (brand-new database/volume). If any user already exists this
# value is ignored and the existing admin password hash is preserved — it never
# resets or overwrites the live admin. The admin must change it on first login.
# Leave blank to have a one-time random password generated and printed instead.
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-secret
# Comma-separated list of the EXACT frontend origin(s) allowed to call the API
# cross-origin. Replace the localhost dev values with your real deployed origin
# (scheme + host + port, no trailing slash), e.g. https://spaghettiprints.ir.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Set true only when the site is served over HTTPS (production) — adds the
# Secure attribute to the auth cookie. Leave false for plain-HTTP local dev.
COOKIE_SECURE=false
# Backend log level: DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
# Public origin used to build customer-facing invoice share links. Must be a
# bare HTTPS origin in production. Plain HTTP is only accepted for an explicit
# local dev host (localhost / 127.0.0.1 / ::1); anything else is rejected.
PUBLIC_SITE_ORIGIN=https://spaghettiprints.ir

# ── Telegram (bot creds + admin alerts) ──────────────────────────────
# Each value is read from env here, then OVERRIDDEN by the matching DB Settings
# row when that row is non-empty (Settings page in the admin UI):
#   TELEGRAM_BOT_TOKEN      <- Settings key: telegram_bot_token
#   TELEGRAM_ADMIN_CHAT_ID  <- Settings key: telegram_admin_chat_id
#   TELEGRAM_PROXY          <- Settings key: telegram_proxy
# A proxy set in the admin Settings page therefore WINS over TELEGRAM_PROXY
# below. Do not overwrite an existing DB setting without operator approval.
# TELEGRAM_ADMIN_CHAT_ID accepts a comma-separated list of chat ids.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# SOCKS5 proxy used for api.telegram.org (PySocks). Use the "socks5" scheme:
#   TELEGRAM_PROXY=socks5://192.168.100.50:10805
# NOTE: a reachable SOCKS5 TCP port does NOT prove authorized Telegram bot
# delivery. A no-credential HTTPS probe via :10805 reached Telegram (HTTP 302),
# but verify a real send before relying on it. Delivery is off the request
# path and best-effort.
TELEGRAM_PROXY=

# ── DigiPay UPG (Task 3) ─────────────────────────────────────────────
# Leave blank to disable online payment (the pay endpoint then returns 503
# instead of pretending to work). Never commit real credentials.
DIGIPAY_CLIENT_ID=
DIGIPAY_CLIENT_SECRET=
DIGIPAY_USERNAME=
DIGIPAY_PASSWORD=
# production (default) or staging — selects the documented UPG base URL
# (production -> api.mydigipay.com, staging/uat -> uat.mydigipay.info).
# CAUTION: "staging" points every payment at the UAT host and its UAT redirect
# allowlist — never use it with live merchant credentials. Leave as production.
DIGIPAY_ENV=production
# Optional override; must be a DigiPay HTTPS host (api.mydigipay.com /
# uat.mydigipay.info). Any other host is refused.
DIGIPAY_BASE_URL=
# Optional absolute HTTPS callback; defaults to PUBLIC_SITE_ORIGIN +
# /api/v1/commerce/digipay/callback.
DIGIPAY_CALLBACK_URL=

# ── Admin notifications (Task 4) ─────────────────────────────────────
# After-commit admin alerts for request_created / invoice_approved /
# payment_verified. Each channel is independent and opt-in: leave a channel's
# credentials blank (or set its toggle to 0/false) and that channel is skipped —
# a missing channel never blocks an order and is never reported as "sent".
# Alerts are dispatched *after* the HTTP response via FastAPI BackgroundTasks, so
# a slow Telegram/SMS/SMTP transport never delays the customer or staff response;
# a channel failure is logged and isolated and can never roll back a committed
# order. There is no durable outbox: if a channel was down (or unconfigured) when
# an event fired, staff resend it explicitly —
#   POST /api/v1/commerce/staff/invoices/{id}/notify  (approved/paid invoice)
#   POST /api/v1/commerce/staff/requests/{id}/notify  (website request)
# both rate-limited to 10/minute.

# Telegram — reuses the existing bot (Settings table or env). Set the toggle to
# 0 to silence Telegram alerts specifically.
COMMERCE_NOTIFY_TELEGRAM=1

# SMS.ir — approved admin alert template. Requires the API key, the approved
# template id AND the admin recipient together; a partial config disables the
# channel rather than sending an untemplated message. Delivery is claimed only
# on a provider acknowledgement (response status == 1).
# The template's parameter placeholders must match the names the app sends
# EXACTLY: SMS.ir substitutes by case-sensitive name. The admin-alert template
# 309349 is approved with #EVENT# / #CODE# and the app sends the uppercase
# names EVENT / CODE. If you register a different template, its placeholders
# must use those exact names.
COMMERCE_NOTIFY_SMS=1
SMS_IR_API_KEY=
SMS_IR_TEMPLATE_ID=
SMS_IR_ADMIN_MOBILE=

# Customer checkout one-time code (storefront cart OTP). FUNCTIONAL delivery to
# the customer's own mobile — independent of the admin SMS channel above: no
# admin recipient, and NOT gated by COMMERCE_NOTIFY_SMS. It needs only
# SMS_IR_API_KEY plus an approved OTP template; delivery is claimed only on a
# provider acknowledgement (response status == 1). The template placeholder must
# be the UPPERCASE name CODE (SMS.ir substitutes case-sensitively); an override
# name that is not UPPERCASE is not substituted and the send is rejected.
SMS_IR_OTP_TEMPLATE_ID=337011
SMS_IR_OTP_PARAM_CODE=CODE

# SMTP — admin mailbox. All of host, username, password, from and to are
# required; there is deliberately no fallback mailbox. SMTP_TLS is "starttls"
# (default, port 587) or "ssl" (port 465).
COMMERCE_NOTIFY_SMTP=1
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_ADMIN_TO=
SMTP_TLS=starttls
